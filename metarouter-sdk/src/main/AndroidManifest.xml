<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required for network operations -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application>
        <!-- Gives the SDK a Context at process start so consent is persisted and
             readable before initialize, as on iOS. Rides AndroidX App Startup's
             shared provider rather than adding one. See MetaRouterInitializer. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="com.metarouter.analytics.MetaRouterInitializer"
                android:value="androidx.startup" />
        </provider>
    </application>

</manifest>
