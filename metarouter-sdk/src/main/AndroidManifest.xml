<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required for network operations -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application>
        <!-- Gives the SDK a Context at process start so consent is persisted and
             readable before initialize, as on iOS. Not exported; serves no data.
             See MetaRouterInitProvider. -->
        <provider
            android:name="com.metarouter.analytics.MetaRouterInitProvider"
            android:authorities="${applicationId}.metarouter-init"
            android:exported="false" />
    </application>

</manifest>
